{
  "name": "gputhing",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "format": "prettier --write .",
    "bench:server": "websocat -s 8765 | tee benchmark.log",
    "bench:chrome": "timeout 5 /Applications/Google\\ Chrome\\ Canary.app/Contents/MacOS/Google\\ Chrome\\ Canary --user-data-dir=/tmp/chrome-bench --no-first-run 'http://localhost:5173/?benchmark' || true",
    "bench:firefox": "timeout 5 /Applications/Firefox\\ Nightly.app/Contents/MacOS/firefox -no-remote -profile /tmp/firefox-bench 'http://localhost:5173/?benchmark' || true",
    "bench:safari": "timeout 5 open -n -a 'Safari Technology Preview' --wait-apps 'http://localhost:5173/?benchmark' || true"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.0.3",
    "@webgpu/types": "^0.1.68",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10",
    "wesl-plugin": "^0.6.49"
  },
  "dependencies": {
    "@solid-primitives/event-listener": "^2.4.3",
    "solid-js": "^1.9.10"
  }
}
